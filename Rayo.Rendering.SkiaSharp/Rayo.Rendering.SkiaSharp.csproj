<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Rayo.Rendering\Rayo.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.Views.Desktop.Common" Version="3.119.4" />
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageId>Rayo.Rendering.SkiaSharp</PackageId>
    <Title>Rayo.Rendering.SkiaSharp</Title>
    <Description>SkiaSharp rendering backend for Rayo.</Description>
  </PropertyGroup>

</Project>
